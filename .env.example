# Local development: leave empty to use http://localhost:3000.
# Production: explicitly set the verified official HTTPS origin in Vercel.
# No official domain has been verified; do not deploy Production with this empty.
NEXT_PUBLIC_SITE_URL=

# Vercel system variable (hostname only). Leave unset locally.
# NEXT_PUBLIC_VERCEL_URL=

# For non-Vercel Production builds/start only; Vercel uses VERCEL_ENV.
# DEPLOYMENT_ENV=production
